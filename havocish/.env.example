# Discord bot credentials -- https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token
CLIENT_ID=your-application-id

# Guild used by `npm run deploy-test-commands` to register guild-scoped slash
# commands instantly (global commands take up to an hour to propagate).
# Only needed for the guild-scoped deploy -- a production process that runs
# `npm run deploy-commands` (global) can leave this unset.
SERVER_ID=your-test-server-id

# Postgres. Apply havocish/db/schema.sql to a fresh database before first run.
#
# QUOTE THIS VALUE. A hosted connection string (Neon's, for one) carries query
# parameters joined by `&`, and an unquoted value silently becomes empty under
# `set -a; . .env; set +a` in bash and a parse error in zsh. dotenv reads the
# file correctly either way, so the bot works and only the shell scripts break.
#
# The quotes are for THIS FILE only. In a host's secret settings (Fly, Vercel)
# paste the bare value: quotes there become part of it, and the bot refuses it.
DATABASE_URL="postgres://user:password@host:5432/havocish?sslmode=require"

# Optional. A Discord webhook URL (channel Settings -> Integrations -> Webhooks).
# The bot posts there when it dies from an uncaught exception or an unhandled
# rejection; leave it unset and the bot runs exactly as before, silently.
# Verify one with `npm run alert:test`.
ALERT_WEBHOOK_URL=

# Optional, production only. API keys for the bot lists, which then show the
# server count (posted at start and every 6 hours). From each list's bot page:
# discord.bots.gg -> docs/API key; discordbotlist.com -> Admin -> Generate Token.
DBOTSGG_TOKEN=
DBL_TOKEN=

# Optional. The dashboard's public address, used by "Open dashboard" buttons.
# Leave unset for https://havocish.com; set http://localhost:3000 when testing
# the dashboard locally.
DASHBOARD_URL=

# Optional. Turns on the HTTP server that draws style previews for the dashboard
# (src/http/previewServer.ts), on PORT (default 8080). Must match the dashboard's
# PREVIEW_SECRET. Generate with `openssl rand -hex 32`.
PREVIEW_SECRET=

# Optional. A Discord webhook in the support server's announcements channel,
# used by `npm run changelog:post -- --send` to post the newest CHANGELOG.md
# entry. Anyone with this URL can post there, so keep it out of git.
CHANGELOG_WEBHOOK_URL=
