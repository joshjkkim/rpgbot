# Discord bot credentials -- https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token
CLIENT_ID=your-application-id

# Guild used by `npm run deploy-test-commands` to register guild-scoped slash
# commands instantly (global commands take up to an hour to propagate).
SERVER_ID=your-test-server-id

# Postgres. Apply rpgbot/db/schema.sql to a fresh database before first run.
DATABASE_URL=postgres://user:password@host:5432/rpgbot
