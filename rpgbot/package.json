{
  "name": "rpgbot",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:watch": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.scripts.json",
    "build": "tsc",
    "deploy-commands": "tsx src/deploy-commands.ts --global",
    "deploy-test-commands": "tsx src/deploy-commands.ts --guild",
    "clear-test-commands": "tsx src/deploy-commands.ts --guild --clear",
    "smoke": "tsx scripts/smoke.ts",
    "doctor": "tsx scripts/doctor.ts",
    "migrate": "./scripts/migrate.sh --all",
    "migrate:status": "./scripts/migrate.sh --status",
    "start": "node dist/index.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/pg": "^8.15.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.93",
    "discord.js": "^14.24.2",
    "dotenv": "^17.2.3",
    "pg": "^8.16.3",
    "twemoji-parser": "^14.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
