# Same database the bot writes to.
DATABASE_URL=postgres://user:password@host:5432/havocish

# NextAuth -- NEXTAUTH_SECRET can be generated with `openssl rand -base64 32`.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-me

# Discord OAuth app. The redirect URI must be registered in the Discord
# developer portal as <NEXTAUTH_URL>/api/auth/callback/discord
DISCORD_CLIENT_ID=your-application-id
DISCORD_CLIENT_SECRET=your-client-secret

# Same application id, exposed to the browser so the site can render the bot's
# install link. Without it the "Add to Server" buttons are hidden.
NEXT_PUBLIC_DISCORD_CLIENT_ID=your-application-id

# The bot's token, used only to list a server's channels and roles for the
# dashboard's pickers. Without it the pickers fall back to typing IDs.
DISCORD_BOT_TOKEN=

# Style previews: where the bot's preview server answers, and the secret shared
# with it (the bot's PREVIEW_SECRET). Generate with `openssl rand -hex 32`.
# Leave unset to hide previews. Locally: http://localhost:8080
BOT_PREVIEW_URL=
PREVIEW_SECRET=

# Optional. A Discord server id whose shop, enemies, quests and achievements
# become the starter pack's content, read live. Edit that server on the
# dashboard to change the pack without a deploy. Unset: app/lib/packs/*.json.
STARTER_PACK_GUILD_ID=
